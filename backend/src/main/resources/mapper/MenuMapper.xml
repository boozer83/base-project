<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.app.mapper.MenuMapper">

    <resultMap id="menuResultMap" type="com.example.app.domain.entity.Menu">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="path" column="path"/>
        <result property="parentId" column="parent_id"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="permission" column="permission"/>
        <result property="isActive" column="is_active"/>
    </resultMap>

    <select id="findByPermissions" resultMap="menuResultMap">
        SELECT id, name, path, parent_id, sort_order, permission, is_active
        FROM menus
        WHERE is_active = TRUE
          AND (
              permission IS NULL
              <if test="permissions != null and !permissions.isEmpty()">
              OR permission IN
              <foreach item="p" collection="permissions" open="(" separator="," close=")">
                  #{p}
              </foreach>
              </if>
          )
        ORDER BY COALESCE(parent_id, id), sort_order
    </select>

</mapper>
